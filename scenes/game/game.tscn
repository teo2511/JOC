[node name="Game" type="Node3D"]
script = ExtResource("1_game")

[node name="TestZone" parent="." instance=ExtResource("2_level")]

[node name="Players" type="Node3D" parent="."]

[node name="PlayerSpawner" type="MultiplayerSpawner" parent="."]
spawn_path = NodePath("../Players")

[node name="ItemSpawner" type="MultiplayerSpawner" parent="."]
_spawnable_scenes = PackedStringArray("res://scenes/items/gift_box.tscn", "res://scenes/items/toy_ball.tscn", "res://scenes/items/wood_block.tscn", "res://scenes/items/toy_car.tscn")
