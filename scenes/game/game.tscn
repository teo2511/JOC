[ext_resource type="Script" path="res://scripts/game/workshop_state.gd" id="4_state"]

[sub_resource type="SceneReplicationConfig" id="Repl_state"]
properties/0/path = NodePath(".:gifts_in_sack")
properties/0/spawn = true
properties/0/replication_mode = 2
properties/1/path = NodePath(".:goal")
properties/1/spawn = true
properties/1/replication_mode = 2
properties/2/path = NodePath(".:money")
properties/2/spawn = true
properties/2/replication_mode = 2
properties/3/path = NodePath(".:total_earned")
